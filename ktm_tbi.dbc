 SG_ TpsDetailedPercent : 7|16@0+ (0.00015258789,0) [0|10] "%" Tester

BO_ 288 DID_0120_OperatingMinutesTotal: 2 ECU
 SG_ OperatingMinutesTotal : 7|16@0+ (1,0) [0|65535] "min" Tester

BO_ 784 DID_0310_TransportLock: 1 ECU
 SG_ LockStatus : 7|8@0+ (1,0) [0|255] "" Tester

BO_ 1030 DID_0404_MapAtmo: 2 ECU
 SG_ MapAtmo : 7|16@0+ (0.1,0) [0|6553.5] "mbar" Tester

BO_ 1034 DID_0406_MapEngine: 2 ECU
 SG_ MapEngine : 7|16@0+ (0.1,0) [0|6553.5] "mbar" Tester

BO_ 1035 DID_040B_TpsAdopted: 2 ECU
 SG_ TpsAdoptedPercent : 7|16@0+ (0.00015258789,0) [0|10] "%" Tester

BO_ 1037 DID_040D_RolledUp: 1 ECU
 SG_ RolledUp : 7|8@0+ (1,0) [0|255] "" Tester

BO_ 1282 DID_0502_OperatingData: 96 ECU
 SG_ OperatingMinutesIdle : 7|16@0+ (1,0) [0|65535] "min" Tester
 SG_ OperatingHoursRaw : 23|768@0+ (1,0) [0|0] "" Tester

BO_ 64810 DID_FD2A_KillSwitch: 1 ECU
 SG_ KillSwitchRaw : 7|8@0+ (1,0) [0|1] "" Tester


// ── UDS DIDs — identification (on-demand ReadDataByIdentifier) ─────────────

BO_ 61713 DID_F111_CalibrationId: 18 ECU
 SG_ CalibrationId : 7|144@0+ (1,0) [0|0] "" Tester

BO_ 61824 DID_F180_BootSoftwareId: 18 ECU
 SG_ BootSoftwareId : 7|144@0+ (1,0) [0|0] "" Tester

