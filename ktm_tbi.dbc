BS_:

BU_: ECU Tester


CM_ "KTM TBI ECU — UDS DIDs + CAN broadcast";
CM_ "UDS transport: ISO-TP req 0x7E0, resp 0x7E8";
CM_ "DID/IOID/RID messages use identifier as pseudo CAN ID (response payload layout)";
CM_ "Source: src/Ecu/Ktm/Tbi/Tbi.hpp";


// ── CAN broadcast (no UDS) ──────────────────────────────────────────────────

BO_ 1754 KTM_TBI_StatusA: 8 ECU
 SG_ TPS_Voltage : 6|9@0+ (0.01,0) [0|5.11] "V" Tester
 SG_ TPS_Angle : 13|8@0+ (0.5,0) [0|127.5] "deg" Tester
 SG_ RPM : 29|14@0+ (1,0) [0|16383] "rpm" Tester

BO_ 1755 KTM_TBI_StatusB: 8 ECU
 SG_ CoolantTemp : 7|8@0- (1,-20) [-20|235] "degC" Tester
 SG_ ExhaustValvePercent : 14|7@0+ (1,0) [0|127] "%" Tester
 SG_ IgnitionAngle : 28|11@0+ (0.4,0) [0|819] "deg" Tester

BO_ 1216 KTM_TBI_MapBtn: 1 ECU
 SG_ MapButton : 7|8@0+ (1,0) [0|255] "" Tester

BO_ 1217 KTM_TBI_MapCmd: 8 ECU
 SG_ MapCommand : 7|8@0+ (1,0) [0|255] "" Tester


