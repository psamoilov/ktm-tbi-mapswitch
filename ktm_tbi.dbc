BO_ 34 RID_0022_ResetAdaptations: 4 ECU
 SG_ OptionRecord : 7|32@0+ (1,0) [0|4294967295] "" Tester

BO_ 8212 RID_2014_PowerValveCalibration: 0 ECU


CM_ BO_ 1754 "CAN broadcast: RPM, TPS voltage/angle (STATUS_A_ID 0x6DA)";
CM_ BO_ 1755 "CAN broadcast: coolant, exhaust valve, ignition angle (STATUS_B_ID 0x6DB)";
CM_ BO_ 1216 "Map button input (BTN_MAP_ID 0x4C0)";
CM_ BO_ 1217 "Map switch command (ECU_MAP_ID 0x4C1)";

CM_ BO_ 259 "DID 0x0103 — ambient air temperature, offset -40 degC";
CM_ BO_ 262 "DID 0x0106 — battery voltage, raw/16";
CM_ BO_ 266 "DID 0x010A — TPS angle, raw/512 deg";
CM_ BO_ 276 "DID 0x0114 — TPS detailed position, 10*raw/65535 %";
CM_ BO_ 288 "DID 0x0120 — total operating minutes";
CM_ BO_ 784 "DID 0x0310 — transport lock (0=unlocked, 1=locked, 2=transport)";
CM_ BO_ 1030 "DID 0x0404 — atmospheric MAP, mbar";
CM_ BO_ 1034 "DID 0x0406 — engine MAP, mbar";
CM_ BO_ 1035 "DID 0x040B — TPS adopted position, 10*raw/65535 %";
CM_ BO_ 1037 "DID 0x040D — rolled-up / side stand";
CM_ BO_ 1282 "DID 0x0502 — idle minutes + operating hours blob (96 bytes)";
CM_ BO_ 64810 "DID 0xFD2A — kill switch (inverted: 0=on, 1=off)";

CM_ BO_ 61713 "DID 0xF111 — calibration ID (ASCII)";
CM_ BO_ 61824 "DID 0xF180 — boot software identification (ASCII)";
CM_ BO_ 61825 "DID 0xF181 — application software identification (ASCII)";
CM_ BO_ 61826 "DID 0xF182 — application data identification (ASCII)";
CM_ BO_ 61836 "DID 0xF18C — ECU serial number (ASCII)";
CM_ BO_ 61840 "DID 0xF190 — VIN (17 bytes ASCII, writable with security)";
CM_ BO_ 61849 "DID 0xF199 — programming date (4 bytes BCD-like)";

CM_ BO_ 65281 "IOID 0xFF01 — fuel pump actuator test";
CM_ BO_ 65282 "IOID 0xFF02 — oil pump actuator test";
CM_ BO_ 65291 "IOID 0xFF0B — power valve (raw 0-255 maps to 0-100%)";
CM_ BO_ 65312 "IOID 0xFF20 — injector 1/2 actuator test";
CM_ BO_ 65313 "IOID 0xFF21 — spark actuator test";
CM_ BO_ 65314 "IOID 0xFF22 — fan actuator test";

CM_ BO_ 34 "RID 0x0022 — reset all adaptations, option 0x7800";
CM_ BO_ 8212 "RID 0x2014 — power valve calibration routine";

CM_ SG_ 1754 TPS_Voltage "Throttle position sensor voltage";
CM_ SG_ 1754 TPS_Angle "Throttle angle";
CM_ SG_ 1754 RPM "Engine speed";
CM_ SG_ 1755 CoolantTemp "Coolant temperature";
CM_ SG_ 1755 ExhaustValvePercent "Power valve opening";
CM_ SG_ 1755 IgnitionAngle "Ignition advance angle";
CM_ SG_ 64810 KillSwitchRaw "Raw value; application inverts: killSwitchOn = !raw";

VAL_ 784 LockStatus 0 "Unlocked" 1 "Locked" 2 "Transport" ;
VAL_ 1037 RolledUp 0 "Down" 1 "Up" ;
VAL_ 64810 KillSwitchRaw 0 "Switch ON (engine allowed)" 1 "Switch OFF (kill active)" ;
VAL_ 1217 MapCommand 4 "Green map" 8 "White map" ;

